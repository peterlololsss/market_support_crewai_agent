</span><span id="__span-31-81"><a id="__codelineno-31-81" name="__codelineno-31-81" href="#__codelineno-31-81"></a><span class="nb">print</span><span class="p">(</span><span class="s2">&quot;ThinkingConfig:&quot;</span><span class="p">,</span> <span class="n">thinking_config</span><span class="p">)</span>

</span><span id="__span-22-18"><a id="__codelineno-22-18" name="__codelineno-22-18" href="#__codelineno-22-18"></a><span class="w">    </span><span class="nx">OutputKey</span><span class="p">:</span><span class="w">    </span><span class="s">&quot;found_capital&quot;</span><span class="p">,</span>

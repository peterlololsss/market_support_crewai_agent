</span><span id="__span-22-6"><a id="__codelineno-22-6" name="__codelineno-22-6" href="#__codelineno-22-6"></a><span class="w">            </span><span class="nx">Type</span><span class="p">:</span><span class="w">        </span><span class="nx">genai</span><span class="p">.</span><span class="nx">TypeString</span><span class="p">,</span>

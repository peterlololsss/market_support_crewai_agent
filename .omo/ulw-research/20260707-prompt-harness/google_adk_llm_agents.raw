</span><span id="__span-31-77"><a id="__codelineno-31-77" name="__codelineno-31-77" href="#__codelineno-31-77"></a><span class="n">thinking_config</span> <span class="o">=</span> <span class="n">ThinkingConfig</span><span class="p">(</span>

</span><span id="__span-21-5"><a id="__codelineno-21-5" name="__codelineno-21-5" href="#__codelineno-21-5"></a><span class="kd">const</span><span class="w"> </span><span class="nx">CapitalOutputSchema</span><span class="o">:</span><span class="w"> </span><span class="kt">Schema</span><span class="w"> </span><span class="o">=</span><span class="w"> </span><span class="p">{</span>

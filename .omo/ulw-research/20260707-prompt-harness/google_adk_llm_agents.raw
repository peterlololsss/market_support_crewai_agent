</span><span id="__span-31-114"><a id="__codelineno-31-114" name="__codelineno-31-114" href="#__codelineno-31-114"></a><span class="n">call_agent</span><span class="p">(</span><span class="s2">&quot;If it&#39;s raining in New York right now, what is the current temperature?&quot;</span><span class="p">)</span>

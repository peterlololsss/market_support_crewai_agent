YANFU_LLM_BASE_URL=https://llm.yanfuinvest.com/v1
YANFU_LLM_PROVIDER=openai
YANFU_LLM_MODEL=deepseek-v4-pro
YANFU_LLM_API_KEY=
YANFU_LLM_TIMEOUT_SECONDS=30
YANFU_LLM_TEMPERATURE=0.1
YANFU_LLM_MAX_TOKENS=1200

CREWAI_VERBOSE=false
CREWAI_MAX_ITER=5
CREWAI_MAX_EXECUTION_TIME=60

AGENT_CONVERSATION_TTL_SECONDS=86400
AGENT_CONVERSATION_MAX_MESSAGES=12
AGENT_CONVERSATION_MAX_SESSIONS=5000
AGENT_CONVERSATION_CLEANUP_INTERVAL_SECONDS=300

# Document MCP knowledge evidence
MARKET_AGENT_DOC_MCP_ENABLED=false
MARKET_AGENT_DOC_MCP_BASE_URL=
MARKET_AGENT_DOC_MCP_TIMEOUT_SECONDS=5
MARKET_AGENT_DOC_MCP_ALLOWED_CHANNEL_TYPES=bank,non_bank
# Per-document evidence ceiling. Keep above the largest real document so a
# selected document is delivered whole; it only fails safe on an oversized doc.
MARKET_AGENT_DOC_MCP_MAX_CHARS_PER_DOCUMENT=16000
# Process-wide cache TTL (seconds) for the static manifest and document content.
# 0 disables caching and re-fetches from the MCP on every query.
MARKET_AGENT_DOC_MCP_CACHE_TTL_SECONDS=300
# Catch-all categories used as baseline evidence when the selector declines.
# Comma-separated; empty disables the fallback.
MARKET_AGENT_DOC_MCP_BASELINE_CATEGORIES=常见问答
